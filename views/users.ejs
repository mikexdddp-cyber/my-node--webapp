<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- ลบ mt-5 ออก และเพิ่ม Flexbox กับ min-height เข้าไปแทน -->
<main class="container d-flex flex-column justify-content-center" style="min-height: 80vh;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">รายชื่อผู้ใช้งานในระบบ</h2>
    <a href="/register" class="btn btn-success">
      + เพิ่มผู้ใช้ใหม่
    </a>
  </div>

  <table class="table table-bordered table-striped">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>ชื่อผู้ใช้งาน</th>
        <th>อีเมล</th>
        <th>วันที่สมัคร</th>
      </tr>
    </thead>

    <tbody>
      <% users_data.forEach(function(user) { %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.username %></td>
          <td><%= user.email %></td>
          <td>
            <%= new Date(user.created_at).toLocaleString('th-TH') %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</main>

<%- include('partials/footer') %>